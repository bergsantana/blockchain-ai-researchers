		"devdoc": {
			"author": "Projeto de estudo — introdução a blockchain",
			"details": "O contrato NÃO guarda o dataset nem as evidências (seria caro demais).      Guarda apenas \"impressões digitais\" (hash SHA-256) e um ponteiro (URI):        - DATASET_HASH      → identifica exatamente qual versão do CSV é a base;        - evidenciaHash     → hash do arquivo de evidência (lista de tweet_ids);        - evidenciaURI      → onde baixar esse arquivo (GitHub raw, ipfs://...).      Qualquer pessoa baixa o CSV, confere o hash, refaz a contagem com      scripts/evidencia.py e confirma se a afirmação é verdadeira.      Para evitar spam, quem afirma deixa um depósito (TAXA_REGISTRO): é      devolvido se a afirmação for confirmada e perdido se for refutada.",
			"kind": "dev",
			"methods": {
				"anexarEvidencia(uint256,bytes32,string)": {
					"params": {
						"evidenciaHash": "Novo SHA-256.",
						"evidenciaURI": "Novo ponteiro.",
						"id": "Afirmação a atualizar (precisa estar Pendente)."
					}
				},
				"apoiar(uint256)": {
					"params": {
						"id": "Afirmação apoiada (Pendente; não pode ser a sua; 1 apoio por conta)."
					}
				},
				"cancelar(uint256)": {
					"params": {
						"id": "Afirmação a cancelar (precisa estar Pendente)."
					}
				},
				"constructor": {
					"params": {
						"_hash": "SHA-256 do arquivo CSV (use `python3 scripts/evidencia.py hash`).",
						"_linhas": "Número de linhas do CSV (74682 no twitter_training.csv).",
						"_nome": "Nome do dataset.",
						"_uri": "Onde baixar o CSV."
					}
				},
				"datasetConfere(bytes32)": {
					"params": {
						"hashLocal": "SHA-256 do arquivo que você baixou."
					}
				},
				"impressao(string,uint8,uint256)": {
					"details": "pure: não lê nem escreve estado."
				},
				"listar(uint256,uint256)": {
					"params": {
						"inicio": "Primeiro id a devolver.",
						"limite": "Quantos itens (será cortado em MAX_PAGINA)."
					}
				},
				"obterAfirmacao(uint256)": {
					"params": {
						"id": "Identificador."
					}
